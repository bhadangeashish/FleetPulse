# FleetPulse TMS - Backend Environment Variables
PORT=5000
NODE_ENV=production

# Database (PostgreSQL URL e.g. on Render, Neon, Supabase, or AWS RDS)
DATABASE_URL=postgresql://fleetpulse_user:password@localhost:5432/fleetpulse_tms?sslmode=prefer

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Allowed Frontend Origins (Comma-separated for local and production Vercel)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://fleetpulse-tms.vercel.app

